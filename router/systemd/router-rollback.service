[Unit]
Description=Luban config rollback watchdog
Documentation=https://github.com/luban/linux-router
# After network target so we can log and communicate, but this unit must NOT
# depend on router-ui (it may be the broken service being rolled back).
After=network.target

[Service]
Type=oneshot
ExecStart=/opt/router/systemd/router-rollback.sh

StandardOutput=journal
StandardError=journal
SyslogIdentifier=luban-rollback

# Do not restart on failure — if the rollback script itself fails it likely
# means the backup files are missing or corrupt; looping would be harmful.
Restart=no
